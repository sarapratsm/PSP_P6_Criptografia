<Window x:Class="Client.Views.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Client.Views"
        mc:Ignorable="d"
        Background="LightSteelBlue"
        Loaded="Window_Loaded"
        Title="Login" Height="400" Width="500">

    <StackPanel Margin="20" VerticalAlignment="Center">
        <TextBlock x:Name="lblLogin" Margin="5" Text="Login" FontSize="22" FontWeight="SemiBold"/>
        <Label x:Name="lblInstructions" Margin="5" Content="Write your username so other people know who you are..."/>
        <TextBox x:Name="txtUser" Margin="5"/>
        <Button x:Name="btnConnect" Margin="5"  Click="btnConnect_Click">Connect</Button>
        <TextBlock x:Name="TxtStatus" Margin="0,10,0,0" Text="" Foreground="Gray" TextWrapping="Wrap" />
    </StackPanel>
</Window>
